# Copy this file to .env in the repository root.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/autoflow
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Required by npm run seed; never used as an application default password.
SEED_PASSWORD=
